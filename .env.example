# Configuration for `docker compose up` (copy to .env and fill in values)

# Secret used to sign JWT access tokens. Required - generate with e.g.
# `openssl rand -base64 32`.
JWT_SECRET=

# Gin mode for the backend: debug (default) or release
GIN_MODE=debug

# Frontend origin allowed for CORS (must match where the frontend is served from)
CORS_ORIGIN=http://localhost:5173

# Backend URL baked into the frontend build
VITE_API_URL=http://localhost:8080
