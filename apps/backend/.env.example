# PostgreSQL connection string
DATABASE_URL=postgres://dev:devpass@localhost:5432/subsurface?sslmode=disable

# HTTP port the API listens on
PORT=8080

# Gin mode: debug (default) or release
GIN_MODE=debug

# Secret used to sign JWT access tokens.
# REQUIRED in release mode; a dev fallback is used otherwise.
JWT_SECRET=

# Frontend origin allowed for CORS (must match exactly; needed for the
# refresh token cookie to work cross-origin)
CORS_ORIGIN=http://localhost:5173
